#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""cabal-purifier: locks what a Cabal project downloads, so that Nix can
build it offline.

  cabal-purifier lock [--no-tests] [--no-benchmarks]
      Writes the lockfile for Cabal's resolution as it is: the plan uses
      the package index as of the last lock, and cabal.project.freeze as
      it is.
  cabal-purifier update [PACKAGE...] [--no-tests] [--no-benchmarks]
      Re-resolves the named packages, or every package, with the newest
      package index, writes cabal.project.freeze again when the project
      has one, and writes the lockfile.
  cabal-purifier prefetch
      Realizes the locked sources, GHC, cabal-install and
      haskell-language-server in the Nix store, keeps them alive with a GC
      root beside the lockfile, and prints the PATH export that puts a
      `cabal` shim first: `eval "$(cabal-purifier prefetch)"`. Every cabal
      command, the language server's included, then runs offline on the
      locked sources.
  cabal-purifier publish PACKAGE [--documentation] [UPLOAD-ARGS...]
      Builds the project's release (or the package's documentation) with
      Nix and uploads the package's tarball with `cabal upload`.

Every command takes --lockfile PATH, or the environment variable
CABAL_PURIFIER_LOCKFILE, for a lockfile outside the project; the default
is cabal-purifier.lock.json at the project root. It also takes
--tool-lockfile PATH, or CABAL_PURIFIER_TOOL_LOCKFILE, for a
cabal.project.freeze kept outside the project. `lock` and `update` write
the freeze file there and leave the copy in the project as it is, and when
the file does not exist yet they start from the copy in the project.

The command reads these environment variables, which its Nix package sets:
CABAL_PURIFIER_LIB (the directory of its Nix library),
CABAL_PURIFIER_NIXPKGS (the nixpkgs it builds with) and
CABAL_PURIFIER_PURIFIER (the source of github:nix-purifiers/purifier, the
library that fetches the locked downloads).
"""

import base64
import hashlib
import importlib.util
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

LOCK_NAME = "cabal-purifier.lock.json"
LOCK_VERSION = 2
PROJECT_FILES = ("cabal.project", "cabal.project.freeze", "cabal.project.local")

# Each Nix system the lock plans for, with the target strings that GHC's
# `--info` reports for it.
SYSTEMS = {
    "x86_64-linux": {"triple": "x86_64-unknown-linux", "arch": "ArchX86_64", "name": "x86_64"},
    "aarch64-linux": {"triple": "aarch64-unknown-linux", "arch": "ArchAArch64", "name": "aarch64"},
}

LIB = Path(os.environ.get("CABAL_PURIFIER_LIB", Path(__file__).resolve().parent.parent / "nix/lib"))
NIXPKGS = os.environ.get("CABAL_PURIFIER_NIXPKGS", "<nixpkgs>")
PURIFIER = os.environ.get("CABAL_PURIFIER_PURIFIER", "")


class Failure(Exception):
    """An error the command reports and exits on."""


def say(message):
    print(f"cabal-purifier: {message}", file=sys.stderr)


def run(cmd, cwd=None, env=None, capture=False):
    result = subprocess.run(
        [str(c) for c in cmd],
        cwd=cwd,
        env=env,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )
    if result.returncode != 0:
        raise Failure(f"`{' '.join(str(c) for c in cmd)}` failed with exit code {result.returncode}")
    return result.stdout if capture else None


def offline_project():
    spec = importlib.util.spec_from_file_location("offline_project", LIB / "offline_project.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def sri_from_hex(hex_digest):
    return "sha256-" + base64.b64encode(bytes.fromhex(hex_digest)).decode()


def sri_of_file(path):
    return sri_from_hex(hashlib.sha256(Path(path).read_bytes()).hexdigest())


def host_system():
    machine = platform.machine()
    for system, target in SYSTEMS.items():
        if target["name"] == machine and sys.platform.startswith("linux"):
            return system
    raise Failure(f"this machine ({machine}, {sys.platform}) is not one of {', '.join(SYSTEMS)}")


def project_root():
    root = Path.cwd()
    if (root / "cabal.project").exists() or any(root.glob("*.cabal")):
        return root
    raise Failure("run cabal-purifier in a Cabal project: a directory with cabal.project or a .cabal file")


def relative_to_root(root, path):
    """A path relative to the project root, with `..` for paths outside it."""
    return os.path.relpath(Path(path).resolve(), root.resolve())


def https(url):
    """The HTTPS URL of a repository. The sandbox has no SSH keys, so an SSH
    URL is locked at the HTTPS URL of the same host and path."""
    scp = re.match(r"^(?:[\w.-]+@)?([\w.-]+):(?!//)(.+)$", url)
    if scp:
        return f"https://{scp.group(1)}/{scp.group(2)}"
    ssh = re.match(r"^ssh://(?:[\w.-]+@)?([\w.-]+)(?::\d+)?/(.+)$", url)
    if ssh:
        return f"https://{ssh.group(1)}/{ssh.group(2)}"
    return url


# --------------------------------------------------------------------------
# The compiler and the planning wrapper


def find_compiler(root):
    """The GHC the project builds with: `with-compiler` of its project
    files, else `ghc` on PATH."""
    name = "ghc"
    for file in PROJECT_FILES:
        path = root / file
        if path.exists():
            for line in path.read_text().splitlines():
                match = re.match(r"^with-compiler\s*:\s*(\S+)", line)
                if match:
                    name = match.group(1)
    found = shutil.which(name)
    if not found:
        raise Failure(f"no compiler {name} on PATH")
    return Path(found)


def ghc_pkg_for(ghc):
    version = run([ghc, "--numeric-version"], capture=True).strip()
    for candidate in (f"ghc-pkg-{version}", "ghc-pkg"):
        beside = ghc.parent / candidate
        if beside.exists():
            return beside
    found = shutil.which(f"ghc-pkg-{version}") or shutil.which("ghc-pkg")
    if not found:
        raise Failure(f"no ghc-pkg for {ghc}")
    return Path(found)


def planning_compiler(tmp, ghc, system):
    """A GHC that reports `system` as its target. Cabal takes the platform
    it plans for from `ghc --info`, so this GHC lets one machine plan for
    every system. It never compiles: the lock run only plans."""
    host = SYSTEMS[host_system()]
    target = SYSTEMS[system]
    info = run([ghc, "--info"], capture=True)
    info = info.replace(host["triple"], target["triple"]).replace(host["arch"], target["arch"])
    info = info.replace(f'"{host["name"]}"', f'"{target["name"]}"')
    directory = Path(tmp) / f"ghc-{system}"
    directory.mkdir()
    (directory / "info").write_text(info)
    wrapper = directory / "ghc"
    wrapper.write_text(
        "#!/bin/sh\n"
        'for arg in "$@"; do\n'
        '  if [ "$arg" = --info ]; then\n'
        f'    cat "{directory / "info"}"\n'
        "    exit\n"
        "  fi\n"
        "done\n"
        f'exec "{ghc}" "$@"\n'
    )
    wrapper.chmod(0o755)
    (directory / "ghc-pkg").symlink_to(ghc_pkg_for(ghc))
    return wrapper


# --------------------------------------------------------------------------
# The lock run


def configuration_flags(configuration):
    return [
        "--enable-tests" if configuration["tests"] else "--disable-tests",
        "--enable-benchmarks" if configuration["benchmarks"] else "--disable-benchmarks",
    ]


def plan(root, env, compiler, builddir, configuration, project_args=(), constraints=()):
    run(
        [
            "cabal",
            "build",
            "all",
            "--dry-run",
            *project_args,
            f"--with-compiler={compiler}",
            f"--builddir={builddir}",
            *configuration_flags(configuration),
            *(f"--constraint={c}" for c in constraints),
        ],
        cwd=root,
        env=env,
    )
    with open(Path(builddir) / "cache" / "plan.json") as f:
        return json.load(f)


def packages_of(plan_json):
    """The packages of a plan, one entry per package with its units."""
    packages = {}
    for unit in plan_json["install-plan"]:
        key = (unit["pkg-name"], unit["pkg-version"])
        packages.setdefault(key, []).append(unit)
    return packages


def index_revisions(repo_cache, wanted):
    """The revision of each wanted package description in the downloaded
    repository indexes. `wanted` maps (name, version) to the SHA-256 (hex)
    of the description the plan used, and the result maps (name, version)
    to that description's revision number. Every revision of a description
    is an entry of the index, so the one with the plan's hash is the one
    Cabal resolved with, whatever the index state."""
    members = {f"{n}/{v}/{n}.cabal": (n, v) for n, v in wanted}
    found = {}
    for index in sorted(Path(repo_cache).glob("*/01-index.tar")):
        with tarfile.open(index) as tar:
            for info in tar:
                key = members.get(info.name)
                if key is None:
                    continue
                text = tar.extractfile(info).read()
                if hashlib.sha256(text).hexdigest() != wanted[key]:
                    continue
                match = re.search(rb"^x-revision\s*:\s*(\d+)", text, re.MULTILINE | re.IGNORECASE)
                found[key] = int(match.group(1)) if match else 0
    return found


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    return Path(base) / "cabal-purifier"


FREEZE = "cabal.project.freeze"


def constraint_package(constraint):
    """The package a constraint of a freeze file is about: `any.async ==2.2.4`
    and `async -bench` are both about async."""
    word = constraint.split()[0] if constraint.split() else ""
    return word.rsplit(".", 1)[-1] if word.startswith("any.") else word


def freeze_without(text, packages):
    """A freeze file without its index-state and without the constraints of
    `packages`, so that `cabal freeze` resolves those again."""
    fields, current = [], None
    for line in text.splitlines():
        if line and not line[0].isspace() and ":" in line:
            current = [line]
            fields.append(current)
        elif current is not None:
            current.append(line)
    kept = []
    for field in fields:
        name, _, value = "\n".join(field).partition(":")
        name = name.strip()
        if name == "index-state":
            continue
        if name == "constraints":
            entries = [c.strip() for c in value.split(",") if c.strip()]
            entries = [c for c in entries if constraint_package(c) not in packages]
            if entries:
                kept.append("constraints: " + ",\n             ".join(entries))
            continue
        kept.append("\n".join(field))
    return "\n".join(kept) + "\n"


def refresh_resolution(root, env, ghc, latest, packages, previous_plans, outside=None):
    """What `update` changes before the lock: Cabal's own resolution, re-
    resolved with the newest index (`latest`) for `packages`, or for every
    package when `packages` is empty.

    With a freeze file, the Cabal lockfile, the constraints of the named
    packages (or the whole file) go, and `cabal freeze` writes it again.
    The freeze file is `outside` when that is given, a copy kept outside
    the project, and the one in the project otherwise. Without a freeze
    file, the other packages keep their versions and flags through
    constraints from the plans of the previous lock, returned per system."""
    freeze = root / FREEZE
    if outside is not None:
        base = outside if outside.exists() else freeze
        text = base.read_text() if base.exists() else ""
        kept = freeze_without(text, set(packages)) if packages else ""
        say(f"writing {outside} again with the newest package index")
        with tempfile.TemporaryDirectory(prefix="cabal-purifier-freeze-") as tmp:
            tmp = Path(tmp)
            seed = tmp / "seed.freeze"
            seed.write_text(kept)
            project = offline_project().write(
                root, tmp / "project", freeze=seed, keep_sources=True
            )
            index_args = [f"--index-state={latest}"] if latest else []
            run(
                [
                    "cabal",
                    "freeze",
                    f"--project-dir={root}",
                    f"--project-file={project}",
                    f"--with-compiler={ghc}",
                    *index_args,
                ],
                cwd=root,
                env=env,
            )
            outside.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(tmp / "project" / FREEZE, outside)
        return {}
    if freeze.exists():
        if packages:
            freeze.write_text(freeze_without(freeze.read_text(), set(packages)))
        else:
            freeze.unlink()
        say(f"writing {FREEZE} again with the newest package index")
        index_args = [f"--index-state={latest}"] if latest else []
        run(["cabal", "freeze", f"--with-compiler={ghc}", *index_args], cwd=root, env=env)
        return {}
    if not packages:
        return {}
    named = set(packages)
    return {
        system: constraints_of([u for u in plan_["units"] if u["name"] not in named and not u["local"]])
        for system, plan_ in previous_plans.items()
    }


def project_index_state_in(path):
    return path.exists() and re.search(r"^index-state\s*:", path.read_text(), re.MULTILINE) is not None


def project_index_state(root):
    """Whether the project's own files pin the package index."""
    return any(project_index_state_in(root / file) for file in PROJECT_FILES)


def prefetch_git(url, rev):
    out = run(
        ["nix-prefetch-git", "--url", url, "--rev", rev, "--fetch-submodules", "--quiet"],
        capture=True,
    )
    data = json.loads(out)
    return data["rev"], data["hash"]


def nix_fetcher_hash(expression):
    """The hash of a fixed-output fetch, from Nix itself: the fetch is built
    with an empty hash, and Nix reports the hash it got."""
    result = subprocess.run(
        ["nix-build", "--no-out-link", "-E", expression],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    match = re.search(r"got:\s*(sha256-[A-Za-z0-9+/=]+)", result.stderr)
    if not match:
        sys.stderr.write(result.stderr)
        raise Failure("could not hash a source repository through Nix")
    return match.group(1)


def source_path(kind, *parts):
    """The download path of a source checkout: the kind and a digest of
    what names the checkout."""
    digest = hashlib.sha256("\0".join(p or "" for p in parts).encode()).hexdigest()[:16]
    return f"source/{kind}-{digest}"


def darcs_context(checkouts, location):
    """The Darcs context of the checkout Cabal made of `location` in the
    lock run, which names the repository's state when the source names no
    tag. Darcs records the location a checkout was cloned from in
    _darcs/prefs/defaultrepo."""
    for checkout in checkouts:
        defaultrepo = checkout / "_darcs" / "prefs" / "defaultrepo"
        if defaultrepo.is_file() and defaultrepo.read_text().strip().rstrip("/") == location.rstrip("/"):
            return run(["darcs", "log", "--context", "--repodir", checkout], capture=True)
    found = ", ".join(c.name for c in checkouts) or "none"
    raise Failure(
        f"found no Darcs checkout of {location} in the lock run to take the context from "
        f"(the checkouts: {found})"
    )


def lock_source_repository(repo, name, version, checkouts):
    """The download and the packing of a `source-repository-package`.
    `checkouts` are the directories where Cabal checked out the project's
    source repositories in the lock run."""
    kind = repo["type"]
    location = repo["location"]
    tag = repo.get("tag") or repo.get("branch")
    subdir = repo.get("subdir") or "."
    if kind == "git":
        url = https(location)
        rev, hash_ = prefetch_git(url, tag or "HEAD")
        download = {
            "path": f"source/git-{rev[:16]}",
            "git": {
                "url": url,
                "rev": rev,
                "submodules": True,
                "leaveDotGit": False,
                "commitObject": None,
            },
            "hash": hash_,
        }
    elif kind in ("mercurial", "hg"):
        if not tag:
            raise Failure(
                f"the Mercurial source of {name} names no tag; give it a `tag`, the "
                "changeset the lock pins"
            )
        # Cabal clones a Mercurial source with its subrepositories.
        expr = (
            f"(import {NIXPKGS} {{}}).fetchhg {{ url = {json.dumps(location)}; "
            f"rev = {json.dumps(tag)}; fetchSubrepos = true; hash = \"\"; }}"
        )
        download = {
            "path": source_path("hg", location, tag),
            "hg": {"url": location, "rev": tag, "subrepos": True},
            "hash": nix_fetcher_hash(expr),
        }
    elif kind == "darcs":
        context = None if tag else darcs_context(checkouts, location)
        pin = (
            f"rev = {json.dumps(tag)};"
            if tag
            else f"context = builtins.toFile \"darcs-context\" {json.dumps(context)};"
        )
        expr = (
            f"(import {NIXPKGS} {{}}).fetchdarcs {{ url = {json.dumps(location)}; "
            f"{pin} hash = \"\"; }}"
        )
        download = {
            "path": source_path("darcs", location, tag, context),
            "darcs": {"url": location, "rev": tag, "context": context},
            "hash": nix_fetcher_hash(expr),
        }
    else:
        raise Failure(
            f"{name} comes from a {kind} source repository. cabal-install syncs only git, "
            "Mercurial and Darcs source repositories, so there is nothing to lock."
        )
    pack = {"from": download["path"], "subdir": subdir, "root": f"{name}-{version}"}
    return download, pack


def lock_remote_tarball(uri):
    import urllib.request

    with urllib.request.urlopen(uri) as response:
        data = response.read()
    digest = hashlib.sha256(data).hexdigest()
    base = re.sub(r"[^A-Za-z0-9+._-]", "_", uri.rstrip("/").rsplit("/", 1)[-1]) or "package"
    return {
        "path": f"remote/{digest[:16]}-{base}",
        "url": uri,
        "mirrors": [],
        "hash": sri_from_hex(digest),
    }


def components_of(units):
    """The components of a local package, from its units in the plan."""
    names = []
    for unit in units:
        if "components" in unit:
            names.extend(unit["components"].keys())
        else:
            names.append(unit.get("component-name", "lib"))
    out = {
        "library": False,
        "sublibraries": [],
        "executables": [],
        "testSuites": [],
        "benchmarks": [],
        "foreignLibraries": [],
    }
    kinds = {
        "lib": "sublibraries",
        "exe": "executables",
        "test": "testSuites",
        "bench": "benchmarks",
        "flib": "foreignLibraries",
    }
    for name in names:
        if name == "lib":
            out["library"] = True
        elif ":" in name:
            kind, component = name.split(":", 1)
            if kind in kinds:
                out[kinds[kind]].append(component)
        # `setup` is the package's Setup script, not an output.
    for key in kinds.values():
        out[key] = sorted(set(out[key]))
    return out


def definition_files(root, local_dirs, freeze=None):
    """The project files the lock is made from, with their hashes. A freeze
    file kept outside the project is recorded under the name of the one in
    the project."""
    files = [f for f in PROJECT_FILES if (root / f).exists()]
    if freeze:
        files.append(FREEZE)
    for directory in local_dirs:
        for cabal_file in sorted((root / directory).glob("*.cabal")):
            files.append(relative_to_root(root, cabal_file))
    return {f: sri_of_file(freeze if freeze and f == FREEZE else root / f) for f in sorted(set(files))}


def make_lock(
    root, configuration, previous_index_state, refresh=None, previous_plans=None, tool=None
):
    """Plans the project for every system and returns the lockfile.

    `tool` is a freeze file kept outside the project. The lock plans with
    it in place of the one in the project and records its hash, and when
    it does not exist yet, it starts as a copy of the one in the project.

    The lock run's Cabal directory is empty apart from the package index,
    which it keeps under ~/.cache/cabal-purifier between runs: Cabal
    updates an index it already has in place. The index is not a download
    of the plan. The plan names the index state the lock records, which
    the next lock reuses unless the project pins its own.

    `refresh` is for `update`: the packages to re-resolve with the newest
    index, or [] for all of them (refresh_resolution)."""
    with tempfile.TemporaryDirectory(prefix="cabal-purifier-") as tmp:
        tmp = Path(tmp)
        repo_cache = cache_dir() / "packages"
        try:
            repo_cache.mkdir(parents=True, exist_ok=True)
            (repo_cache / ".writable").touch()
        except OSError as error:
            say(
                f"cannot keep the package index in {repo_cache} ({error.strerror}); this lock run "
                "downloads the whole index again. Set XDG_CACHE_HOME to a writable directory to "
                "keep it between runs."
            )
            repo_cache = tmp / "packages"
            repo_cache.mkdir()
        (tmp / "cabal").mkdir()
        (tmp / "cabal" / "config").write_text(
            "repository hackage.haskell.org\n"
            "  url: http://hackage.haskell.org/\n"
            "  secure: True\n"
            f"remote-repo-cache: {repo_cache}\n"
        )
        env = dict(os.environ, CABAL_DIR=str(tmp / "cabal"))
        say("updating the package indexes")
        updated = run(["cabal", "update"], cwd=root, env=env, capture=True)
        sys.stderr.write(updated)
        latest = re.findall(r"index-state is set to (\S+?)\.?$", updated, re.MULTILINE)
        latest = latest[-1] if latest else None
        ghc = find_compiler(root)
        if tool is not None and not tool.exists() and (root / FREEZE).exists():
            tool.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(root / FREEZE, tool)
        pins = {}
        if refresh is not None:
            pins = refresh_resolution(
                root, env, ghc, latest, refresh, previous_plans or {}, tool
            )
        freeze = tool if tool is not None and tool.exists() else None
        if project_index_state(root) or (freeze and project_index_state_in(freeze)):
            index_state = None
        elif previous_index_state and refresh is None:
            index_state = previous_index_state
        else:
            index_state = latest
        index_args = [f"--index-state={index_state}"] if index_state else []
        if freeze:
            # Cabal reads the freeze file beside the project file, so a copy
            # of the project file in the lock run's directory has it.
            project = offline_project().write(
                root, tmp / "lock-project", freeze=freeze, keep_sources=True
            )
            index_args += [f"--project-dir={root}", f"--project-file={project}"]

        plans = {}
        for system in SYSTEMS:
            say(f"planning for {system}")
            try:
                plans[system] = plan(
                    root,
                    env,
                    planning_compiler(tmp, ghc, system),
                    tmp / f"dist-{system}",
                    configuration,
                    index_args,
                    pins.get(system, ()),
                )
            except Failure as error:
                hint = (
                    f" The plan uses the package index as of {index_state}, which the last "
                    "lock recorded; a dependency newer than that needs "
                    "`cabal-purifier update`, which takes the newest index."
                    if index_state and index_state == previous_index_state
                    else ""
                )
                raise Failure(f"Cabal could not plan the project for {system}.{hint}") from error

        downloads = {}
        repository = {}
        remote = {}
        externals = set()
        outputs = {}
        systems = {}
        hackage = {}

        for system, plan_json in plans.items():
            units_out = []
            for (name, version), units in sorted(packages_of(plan_json).items()):
                unit = units[0]
                installed = unit["type"] == "pre-existing"
                local = unit.get("style") == "local"
                units_out.append(
                    {
                        "name": name,
                        "version": version,
                        "flags": unit.get("flags") or {},
                        "installed": installed,
                        "local": local,
                    }
                )
                if installed:
                    continue
                src = unit.get("pkg-src") or {}
                pid = f"{name}-{version}"
                kind = src.get("type")
                if kind == "local":
                    directory = relative_to_root(root, src["path"])
                    if directory.startswith(".."):
                        externals.add(directory)
                    if local and not directory.startswith(".."):
                        outputs[name] = {
                            "version": version,
                            "dir": directory,
                            **components_of(units),
                        }
                elif kind == "local-tar":
                    path = relative_to_root(root, src["path"])
                    if path.startswith(".."):
                        raise Failure(
                            f"{pid} is a tarball outside the project ({path}); move it into the "
                            "project, where the Nix build can read it"
                        )
                elif kind == "repo-tar":
                    repo = src["repo"]
                    if repo["type"] in ("secure-repo", "remote-repo"):
                        uri = repo["uri"].rstrip("/")
                        if uri == "http://hackage.haskell.org":
                            uri = "https://hackage.haskell.org"
                        hackage[(name, version)] = (uri, unit)
                    elif repo["type"] in ("local-repo-no-index", "local-repo"):
                        path = relative_to_root(root, Path(repo["path"]) / f"{pid}.tar.gz")
                        if path.startswith(".."):
                            raise Failure(
                                f"{pid} comes from the local repository {repo['path']}, outside the "
                                "project; move the repository into the project"
                            )
                        repository[f"{pid}.tar.gz"] = {"file": f"{pid}.tar.gz", "project": path}
                    else:
                        raise Failure(f"{pid} comes from a repository of type {repo['type']}")
                elif kind == "source-repo":
                    # Cabal names a checkout after the repository rather
                    # than the package, so each is a candidate.
                    checkouts = sorted(
                        p for p in (tmp / f"dist-{system}" / "src").glob("*") if p.is_dir()
                    )
                    download, pack = lock_source_repository(
                        src["source-repo"], name, version, checkouts
                    )
                    downloads[download["path"]] = download
                    repository[f"{pid}.tar.gz"] = {"file": f"{pid}.tar.gz", "pack": pack}
                elif kind == "remote-tar":
                    uri = src["uri"]
                    # A package URL is a dependency the project downloads,
                    # so it is locked but is not one of the outputs.
                    if uri not in remote:
                        download = lock_remote_tarball(uri)
                        downloads[download["path"]] = download
                        remote[uri] = {"uri": uri, "from": download["path"], "package": pid}
                else:
                    raise Failure(f"{pid} has a source of type {kind}, which the lock does not know")
            systems[system] = {"compiler": plan_json["compiler-id"], "units": units_out}

        revisions = index_revisions(
            repo_cache, {key: unit["pkg-cabal-sha256"] for key, (_, unit) in hackage.items()}
        )
        for (name, version), (uri, unit) in sorted(hackage.items()):
            pid = f"{name}-{version}"
            tarball = {
                "path": f"repository/{pid}.tar.gz",
                "url": f"{uri}/package/{pid}.tar.gz",
                "mirrors": [f"{uri}/package/{pid}/{pid}.tar.gz"],
                "hash": sri_from_hex(unit["pkg-src-sha256"]),
            }
            downloads[tarball["path"]] = tarball
            if (name, version) not in revisions:
                raise Failure(
                    f"no package index holds the description of {pid} that the plan used; "
                    "run `cabal-purifier lock --update`"
                )
            revision = revisions[(name, version)]
            if revision > 0:
                description = {
                    "path": f"repository/{pid}.cabal",
                    "url": f"{uri}/package/{pid}/revision/{revision}.cabal",
                    "mirrors": [],
                    "hash": sri_from_hex(unit["pkg-cabal-sha256"]),
                }
                downloads[description["path"]] = description

        local_dirs = sorted({o["dir"] for o in outputs.values()})
        lock = {
            "version": LOCK_VERSION,
            "configuration": configuration,
            "indexState": index_state,
            "definition": definition_files(root, local_dirs, freeze),
            "downloads": [downloads[p] for p in sorted(downloads)],
            "repository": [repository[f] for f in sorted(repository)],
            "remotePackages": [remote[u] for u in sorted(remote)],
            "externalPaths": sorted(externals),
            "systems": systems,
            "outputs": {"packages": {n: outputs[n] for n in sorted(outputs)}},
        }
        lock["hash"] = content_hash(lock)
        return lock


def content_hash(lock):
    """The SRI SHA-256 of the lockfile without its `hash`, in the JSON that
    Nix's builtins.toJSON writes: keys sorted and no spaces. lock.nix
    computes the same hash."""
    body = {k: v for k, v in lock.items() if k != "hash"}
    text = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return sri_from_hex(hashlib.sha256(text.encode()).hexdigest())


# --------------------------------------------------------------------------
# The locked sources, for the check after a lock and for `cabal`


def purifier_source():
    if not PURIFIER:
        raise Failure(
            "CABAL_PURIFIER_PURIFIER is not set; run cabal-purifier from its Nix package, "
            "which sets it to the source of github:nix-purifiers/purifier"
        )
    return PURIFIER


def realize(root, lock_path, out_link, freeze=None):
    out_link.parent.mkdir(parents=True, exist_ok=True)
    try:
        out = run(
            [
                "nix-build",
                LIB / "realize.nix",
                "--argstr",
                "lockFile",
                lock_path.resolve(),
                "--argstr",
                "src",
                root.resolve(),
                "--argstr",
                "system",
                host_system(),
                "--argstr",
                "nixpkgs",
                NIXPKGS,
                "--argstr",
                "purifier",
                purifier_source(),
                *freeze_args(freeze),
                "--out-link",
                out_link,
            ],
            capture=True,
        )
    except Failure as error:
        raise Failure(
            "Nix could not fetch the locked sources (its error is above). A hash mismatch means "
            "a download no longer matches the lockfile: the lockfile was edited, or a source "
            "changed upstream. Run `cabal-purifier lock` to lock the sources as they are now."
        ) from error
    return Path(out.strip().splitlines()[-1])


def constraints_of(units):
    lines = []
    for unit in units:
        if unit["installed"]:
            lines.append(f"any.{unit['name']} installed")
            continue
        lines.append(f"any.{unit['name']} =={unit['version']}")
        if unit["flags"]:
            flags = " ".join(("+" if on else "-") + f for f, on in sorted(unit["flags"].items()))
            lines.append(f"any.{unit['name']} {flags}")
    return lines


def freeze_args(freeze):
    """The nix-build arguments for a freeze file kept outside the project."""
    return ["--argstr", "cabalFreeze", Path(freeze).resolve()] if freeze else []


def offline_setup(root, lock, sources, work, freeze=None):
    """A Cabal directory whose only repository is the locked one, and the
    offline copy of the configuration of the project, with `freeze` in
    place of the freeze file of the project when it is given. Returns the
    environment and the project arguments for cabal."""
    work.mkdir(parents=True, exist_ok=True)
    repo = work / "repository"
    if repo.exists():
        shutil.rmtree(repo)
    repo.mkdir()
    # Cabal writes noindex.cache into the repository, so the repository is
    # a writable directory of links into the store.
    for entry in (sources / "repo").iterdir():
        (repo / entry.name).symlink_to(entry)
    cabal_dir = work / "cabal"
    cabal_dir.mkdir(exist_ok=True)
    (cabal_dir / "config").write_text(
        "repository purified\n"
        f"  url: file+noindex://{repo.resolve()}\n"
        "active-repositories: purified\n"
    )
    remote = json.loads((sources / "remote.json").read_text())
    system = host_system()
    if system not in lock["systems"]:
        raise Failure(f"the lockfile has no plan for {system}; run `cabal-purifier lock`")
    project = offline_project().write(
        root,
        work / "project",
        remote,
        constraints_of(lock["systems"][system]["units"]),
        freeze=freeze,
    )
    env = dict(os.environ, CABAL_DIR=str(cabal_dir))
    return env, [f"--project-dir={root}", f"--project-file={project}"]


def check_lock(root, lock_path, lock, freeze=None):
    """Resolves the project offline from the locked sources alone, which
    shows that the lock holds everything the plan needs."""
    say("checking the lock: resolving offline from the locked sources")
    with tempfile.TemporaryDirectory(prefix="cabal-purifier-check-") as tmp:
        tmp = Path(tmp)
        sources = realize(root, lock_path, tmp / "sources", freeze)
        env, project_args = offline_setup(root, lock, sources, tmp / "work", freeze)
        system = host_system()
        resolved = plan(
            root,
            env,
            find_compiler(root),
            tmp / "dist",
            lock["configuration"],
            project_args,
        )
        locked = {(u["name"], u["version"]) for u in lock["systems"][system]["units"]}
        got = set(packages_of(resolved))
        if got != locked:
            missing = sorted(f"{n}-{v}" for n, v in locked - got)
            extra = sorted(f"{n}-{v}" for n, v in got - locked)
            raise Failure(
                "the offline resolution differs from the lock"
                + (f"; missing: {', '.join(missing)}" if missing else "")
                + (f"; extra: {', '.join(extra)}" if extra else "")
            )


# --------------------------------------------------------------------------
# Verbs


def lock_problems(lock):
    """What is inconsistent in a lockfile: references to downloads it does
    not hold, and packages of a plan that no locked source provides. The
    Nix library makes the same checks (lock.nix)."""
    problems = []
    downloads = {d.get("path") for d in lock.get("downloads", [])}
    # A download at repository/<file> is that file of the repository.
    files = {p.removeprefix("repository/") for p in downloads if p and p.startswith("repository/")}
    for entry in lock.get("repository", []):
        files.add(entry.get("file"))
        source = (entry.get("pack") or {}).get("from")
        if source is not None and source not in downloads:
            problems.append(f"the repository file {entry.get('file')} names no download {source}")
    remote = set()
    for entry in lock.get("remotePackages", []):
        remote.add(entry.get("package"))
        if entry.get("from") not in downloads:
            problems.append(f"the package URL {entry.get('uri')} names no download {entry.get('from')}")
    for system, plan_ in lock.get("systems", {}).items():
        for unit in plan_.get("units", []):
            if unit.get("installed") or unit.get("local"):
                continue
            pid = f"{unit.get('name')}-{unit.get('version')}"
            if f"{pid}.tar.gz" not in files and pid not in remote:
                problems.append(f"the plan for {system} uses {pid}, which no locked source provides")
    return problems


SECTIONS = (
    "version",
    "hash",
    "configuration",
    "definition",
    "downloads",
    "repository",
    "remotePackages",
    "externalPaths",
    "systems",
    "outputs",
)


def read_lock(path):
    """The lockfile at `path`, after the checks that lock.nix makes too."""
    if not path.exists():
        raise Failure(f"there is no {path}; run `cabal-purifier lock`")
    try:
        with open(path) as f:
            lock = json.load(f)
    except json.JSONDecodeError as error:
        raise Failure(
            f"{path} is not valid JSON ({error.msg} at line {error.lineno}). Run "
            "`cabal-purifier lock` to write it again."
        ) from error
    if not isinstance(lock, dict):
        raise Failure(f"{path} is damaged: it is not a JSON object. Run `cabal-purifier lock` to write it again.")
    if lock.get("version") != LOCK_VERSION:
        raise Failure(
            f"{path} has lock format version {lock.get('version')}; this command writes "
            f"version {LOCK_VERSION}. Run `cabal-purifier lock`."
        )
    missing = [key for key in SECTIONS if key not in lock]
    if missing:
        problems = [f"it has no {', '.join(missing)}"]
    elif lock["hash"] != content_hash(lock):
        problems = ["its content does not match its hash, so it was changed after `cabal-purifier lock` wrote it"]
    else:
        problems = lock_problems(lock)
    if problems:
        raise Failure(
            f"{path} is damaged: " + "; ".join(problems) + ". Run `cabal-purifier lock` to write it again."
        )
    return lock


def stale_files(root, lock, freeze=None):
    """The project files that changed since the lock. A freeze file kept
    outside the project takes the place of the one in the project."""
    stale = []
    for file, digest in lock["definition"].items():
        path = freeze if freeze and file == FREEZE else root / file
        if not path.exists() or sri_of_file(path) != digest:
            stale.append(file)
    return stale


def parse_lock_options(args):
    """The plan's configuration, and the arguments that are not options."""
    configuration = {"tests": True, "benchmarks": True}
    rest = []
    for arg in args:
        if arg == "--no-tests":
            configuration["tests"] = False
        elif arg == "--no-benchmarks":
            configuration["benchmarks"] = False
        elif arg.startswith("-"):
            raise Failure(f"unknown option {arg}; see `cabal-purifier --help`")
        else:
            rest.append(arg)
    return configuration, rest


def lockfile_path(root, option):
    """The purifier lockfile: `--lockfile`, then CABAL_PURIFIER_LOCKFILE,
    then cabal-purifier.lock.json at the project root."""
    given = option or os.environ.get("CABAL_PURIFIER_LOCKFILE")
    return Path(given).resolve() if given else root / LOCK_NAME


def tool_lockfile_path(option):
    """The freeze file kept outside the project: `--tool-lockfile`, then
    CABAL_PURIFIER_TOOL_LOCKFILE, and None when neither is given."""
    given = option or os.environ.get("CABAL_PURIFIER_TOOL_LOCKFILE")
    return Path(given).resolve() if given else None


def outside_freeze(tool):
    """The freeze file kept outside the project, when it exists."""
    return tool if tool is not None and tool.exists() else None


def previous_lock(path):
    """The last lockfile as JSON, even one of an older format or one that no
    longer passes the checks: `lock` takes its index state, and `update`
    its plans."""
    try:
        previous = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return previous if isinstance(previous, dict) else {}


def verb_lock(root, path, tool, args):
    """Locks the resolution of Cabal as it is: the plan uses the package
    index as of the last lock, and the freeze file as it is."""
    configuration, rest = parse_lock_options(args)
    if rest:
        raise Failure(
            f"`cabal-purifier lock` takes no packages; `cabal-purifier update {' '.join(rest)}` "
            "re-resolves them"
        )
    index_state = previous_lock(path).get("indexState")
    lock = make_lock(
        root,
        configuration,
        index_state if isinstance(index_state, str) else None,
        tool=tool,
    )
    write_lock(root, path, lock, outside_freeze(tool))


def verb_update(root, path, tool, args):
    """Re-resolves the named packages, or every package, with the newest
    package index, writes the freeze file again when the project has one,
    and locks the result."""
    configuration, packages = parse_lock_options(args)
    previous = previous_lock(path)
    plans = previous.get("systems") if isinstance(previous.get("systems"), dict) else {}
    if packages and not plans and not (root / FREEZE).exists():
        raise Failure("there is no lock to keep the other packages from; run `cabal-purifier update` for every package")
    pinned = [f for f in PROJECT_FILES if f != FREEZE and project_index_state_in(root / f)]
    if pinned:
        say(f"{', '.join(pinned)} pins index-state, so the update resolves with the index as of that state")
    lock = make_lock(
        root, configuration, None, refresh=packages, previous_plans=plans, tool=tool
    )
    write_lock(root, path, lock, outside_freeze(tool))


def write_lock(root, path, lock, freeze=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(lock, indent=2, sort_keys=True) + "\n")
    say(
        f"wrote {path}: {len(lock['downloads'])} downloads, "
        f"{len(lock['outputs']['packages'])} project packages"
    )
    check_lock(root, path, lock, freeze)
    say("the lock resolves offline to the locked plan")


def read_current_lock(root, path, freeze=None):
    """The lockfile, which must be as new as the project's Cabal files."""
    lock = read_lock(path)
    stale = stale_files(root, lock, freeze)
    if stale:
        raise Failure(
            f"{', '.join(stale)} changed since the lock, so the lock may lack downloads the "
            "project now needs. Run `cabal-purifier lock`."
        )
    return lock


def work_dir(root):
    return root / "dist-newstyle" / "cabal-purifier"


def prefetch_root(path):
    """The GC root of `prefetch`, beside the lockfile: for
    cabal-purifier.lock.json, cabal-purifier.lock.prefetch."""
    return path.with_name(path.name.removesuffix(".json") + ".prefetch")


def verb_prefetch(root, path, tool, args):
    """Realizes the locked sources and the toolchain for this system, keeps
    them alive with a GC root beside the lockfile, and writes the `cabal`
    shim. Prints the PATH export that puts the shim and the toolchain
    first: every cabal command, the language server's included, then runs
    offline on the locked sources."""
    if args:
        raise Failure(
            "`cabal-purifier prefetch` takes no arguments but --lockfile and --tool-lockfile"
        )
    freeze = outside_freeze(tool)
    read_current_lock(root, path, freeze)
    say("realizing the locked sources and the toolchain")
    out = run(
        [
            "nix-build",
            LIB / "prefetch.nix",
            "--argstr",
            "lockFile",
            path,
            "--argstr",
            "src",
            root.resolve(),
            "--argstr",
            "system",
            host_system(),
            "--argstr",
            "nixpkgs",
            NIXPKGS,
            "--argstr",
            "purifier",
            purifier_source(),
            *freeze_args(freeze),
            "--out-link",
            prefetch_root(path),
        ],
        capture=True,
    )
    prefetched = Path(out.strip().splitlines()[-1])
    self = os.environ.get("CABAL_PURIFIER_SELF") or shutil.which("cabal-purifier")
    if not self:
        raise Failure("cannot find the cabal-purifier command for the shim")
    shims = work_dir(root) / "bin"
    shims.mkdir(parents=True, exist_ok=True)
    shim = shims / "cabal"
    variables = f'CABAL_PURIFIER_SHIM=1 CABAL_PURIFIER_LOCKFILE="{path}"'
    if freeze:
        variables += f' CABAL_PURIFIER_TOOL_LOCKFILE="{freeze}"'
    shim.write_text(f'#!/bin/sh\n{variables} exec "{self}" "$@"\n')
    shim.chmod(0o755)
    toolchain = work_dir(root) / "toolchain"
    if toolchain.is_symlink() or toolchain.exists():
        toolchain.unlink()
    toolchain.symlink_to(prefetched / "toolchain")
    say(f"prefetched {prefetched}, kept alive by {prefetch_root(path)}")
    print(f'export PATH="{shims}:{toolchain}/bin:$PATH"')


def shim_cabal(root, path, tool, args):
    """What the `cabal` shim runs: cabal offline on the locked sources."""
    if not path.exists():
        say('warning: no cabal-purifier.lock.json found; running cabal impurely. Run `cabal-purifier lock` to use Nix-resolved dependencies.')
        env = dict(os.environ)
        env.pop("CABAL_PURIFIER_SHIM", None)
        cabal = real_cabal(root)
        os.execve(cabal, [cabal, *args], env)
    freeze = outside_freeze(tool)
    lock = read_current_lock(root, path, freeze)
    work = work_dir(root)
    sources = realize(root, path, work / "sources", freeze)
    env, project_args = offline_setup(root, lock, sources, work, freeze)
    env.pop("CABAL_PURIFIER_SHIM", None)
    # The project arguments go after the subcommand, which follows any
    # global options: the language server runs `cabal --builddir=… repl`.
    command = next((i for i, a in enumerate(args) if not a.startswith("-")), None)
    if command is not None:
        args = [*args[: command + 1], *project_args, *args[command + 1 :]]
    cabal = real_cabal(root)
    os.execve(cabal, [cabal, *args], env)


def real_cabal(root):
    """The cabal on PATH, past the shim, so that the shim does not run
    itself."""
    shims = (work_dir(root) / "bin").resolve()
    path = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p and Path(p).resolve() != shims]
    found = shutil.which("cabal", path=os.pathsep.join(path))
    if not found:
        raise Failure("no cabal on PATH")
    return found


def verb_publish(root, path, tool, args):
    """Uploads the release Nix built: the source tarball of each named
    package, or with --documentation the documentation tarball of one."""
    documentation = "--documentation" in args
    args = [a for a in args if a != "--documentation"]
    freeze = outside_freeze(tool)
    lock = read_current_lock(root, path, freeze)
    packages = lock["outputs"]["packages"]
    if not args or args[0].startswith("-"):
        raise Failure("name the package to publish, as in `cabal-purifier publish my-package`")
    package, rest = args[0], args[1:]
    if package not in packages:
        raise Failure(f"the project has no package {package}; it has " + ", ".join(sorted(packages)))
    version = packages[package]["version"]
    say(f"building the {'documentation' if documentation else 'release'} of {package} with Nix")
    out = run(
        [
            "nix-build",
            "--no-out-link",
            LIB / "publish.nix",
            "--argstr",
            "src",
            root.resolve(),
            "--argstr",
            "lockFile",
            path,
            "--argstr",
            "documentation",
            package if documentation else "",
            "--argstr",
            "nixpkgs",
            NIXPKGS,
            "--argstr",
            "purifier",
            purifier_source(),
            *freeze_args(freeze),
        ],
        capture=True,
    )
    built = Path(out.strip().splitlines()[-1])
    suffix = "-docs.tar.gz" if documentation else ".tar.gz"
    tarball = built / f"{package}-{version}{suffix}"
    cabal = real_cabal(root)
    upload = [cabal, "upload", *(["--documentation"] if documentation else []), *rest, tarball]
    say(f"uploading {tarball}")
    os.execv(cabal, [str(c) for c in upload])


VERBS = {"lock": verb_lock, "update": verb_update, "prefetch": verb_prefetch, "publish": verb_publish}


def take_option(args, name):
    """`--name PATH` or `--name=PATH` from anywhere in the arguments."""
    rest, option = [], None
    i = 0
    while i < len(args):
        if args[i] == name:
            if i + 1 == len(args):
                raise Failure(f"{name} needs a path")
            option = args[i + 1]
            i += 2
            continue
        if args[i].startswith(name + "="):
            option = args[i].split("=", 1)[1]
        else:
            rest.append(args[i])
        i += 1
    return option, rest


def main(argv):
    try:
        if os.environ.get("CABAL_PURIFIER_SHIM") == "1":
            root = project_root()
            shim_cabal(root, lockfile_path(root, None), tool_lockfile_path(None), argv)
            return 0
        if not argv or argv[0] in ("-h", "--help", "help"):
            print(__doc__)
            return 0
        verb, args = argv[0], argv[1:]
        if verb not in VERBS:
            raise Failure(f"unknown command {verb}; see `cabal-purifier --help`")
        option, args = take_option(args, "--lockfile")
        tool_option, args = take_option(args, "--tool-lockfile")
        root = project_root()
        VERBS[verb](root, lockfile_path(root, option), tool_lockfile_path(tool_option), args)
    except Failure as error:
        say(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
